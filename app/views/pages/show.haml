= page_column(@current_project,@pages,@page)

= people_watching(@current_project,current_user,@page)
.page_header{:class => (@page.is_private ? 'private' : '')}
  = page_action_links(@current_project,@page)
  %h2
    .lock_icon
    =h @page
  .description=h @page.description

= @page.content

#slots
  - @page.slots.with_widgets.each do |page_slot|
    = render 'pages/slot', page_slot: page_slot, page: @page, project: @current_project

#pageInsert{ style: 'display: none' }

= page_buttons(@current_project, @page)
