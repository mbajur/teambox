- cache_comment(comment) do
  %div[comment]{ comment_data(comment) }
    .info
      = micro_avatar(comment.user)
    .block
      - unless rss?
        .actions_menu{ data: { controller: "comment-actions", "comment-actions-editable-before-value" => datetime_ms(15.minutes.since(comment.created_at)), 'comment-actions-is-admin-value' => comment.project.admin?(current_user) } }
          %template{ data: { "comment-actions-target": "uneditableTpl" } }
            %span.edit{ data: { "comment-actions-target": "editLink" } }= t('.cannot_edit')

          %span.actiondate{ data: { action: "mouseover->comment-actions#refreshEditLinkVisibility" } }
            = posted_date comment.created_at

          = image_tag('triangle.png', :class => 'triangle')

          .extra
            - if can?(:update, comment)
              = link_to t('comments.actions.edit'), [:edit, comment.project, comment.target, comment],
               :class => :edit, :'data-turbo-prefetch' => false, :"data-comment-actions-target" => "editLink", data: { turbo_frame: "modal" }
            = link_to t('comments.actions.post_by_email'), email_posts_path(:target_type => comment.target_type, :target_id => comment.target_id, :project_permalink => comment.project.permalink), :rel => 'facebox'

            - if can?(:destroy, comment)
              = link_to t('common.delete'), [comment.project, comment.target, comment], :'data-method' => 'delete',
                :'data-confirm' => t('.confirm_delete'), :'data-turbo' => true, :class => :delete, :'data-turbo-prefetch' => false
      .body.textilized
        .before
          = link_to(comment.user.name, comment.user, :class => :user) + " "
          - if comment.task_comment?
            = comment_task_status(comment)
            = comment_task_due_on(comment)
          - if comment.hours?
            = content_tag(:span, human_hours(comment.hours), :class => :hours)

        - if comment.task_comment? and comment.assigned_transition?
          %p.assigned_transition
            - if comment.assigned and comment.assigned.user
              = t('tasks.assigned.assigned_to', :user => comment.assigned.user.name)
            - else
              = t('tasks.assigned.unassigned')

        ~raw comment.body_html

      - if comment.uploads.any?
        - if comment.uploads.all? { |upload| upload.image? }
          .upload_images
            = list_uploads_inline_with_thumbnails(comment.uploads)
        - else
          .upload_list
            = list_uploads_inline(comment.uploads)

      - if comment.google_docs.any?
        %ul.google_docs_list
          = render :partial => 'google_docs/file', :collection => comment.google_docs, :as => :google_doc

    .clear
