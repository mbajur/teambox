- task_form = nil unless local_assigns[:task_form]
- parent_form = (local_assigns[:task_form] || local_assigns[:conversation_form])

.field.text_area
  %a.micro_avatar.my_avatar{ :href => '#' }
  .textarea
    = f.text_area :body, :placeholder => local_assigns[:placeholder], :id => nil, :style => request.xhr? ? 'max-height: 300px' : nil, data: { "comment-target" => "bodyInput" }

.extra
  - if task_form
    .field.text_field.hours_field.invisible
      %label
        = t('comments.hours.hours')
        = f.text_field :human_hours
      = time_tracking_doc

  .upload_area.invisible{ 'data-comment-target' => 'uploadArea' }
    %p= t('uploads.new.select_a_file')
    - f.object.uploads.build
    = f.fields_for :uploads do |fields|
      = fields.file_field :asset, :id => 'upload_file', data: { action: 'change->comment#onUploadChanged' }

  .add_watchers_box.invisible{ 'data-comment-target' => 'watchersArea' }
    %p= t('comments.watchers.explain')
    %div{ class: 'watcher'}
      %a{ href: '#', "data-login": 'all', "data-action" => "comment#onAddWatcher" }= 'All users'

    - Current.projects_and_people.people_for_project(target.project).each do |person|
      %div{ class: 'watcher'}
        %a{ href: '#', "data-login": person.login, "data-action" => "comment#onAddWatcher" }= person.name

  .private_options.invisible{ 'object-prefix' => "#{f.object.target_type.downcase}_#{f.object.target_id}", 'object-type' => f.object_name, 'data-comment-target' => 'privacyArea', 'data-controller' => 'private-box', 'data-private-box-is-private-value' => target.is_private.to_s }
    .private_users
      - if parent_form
        .option.normal
          %label
            = parent_form.radio_button :is_private, 0, checked: !target.is_private?, data: { action: 'private-box#switchToPublic' }
            = I18n.t('comments.private.public')
        .option.private
          %label
            = parent_form.radio_button :is_private, 1, checked: target.is_private?, data: { action: 'private-box#switchToPrivate' }
            = I18n.t('comments.private.private_global')

        %div.invisible{ data: { 'private-box-target' => 'privateContent', controller: 'checkbox-select-all' } }
          %br
          %div{ class: 'private_all'}
            %input{ id: "#{f.object.id}_private_all", name: "comment[all_private]", type: 'checkbox', value: 'true', data: { 'checkbox-select-all-target' => 'checkboxAll' } }
            %label{ for: "#{f.object.id}_private_all"}= I18n.t('comments.private.all')

          - Current.projects_and_people.people_for_project(target.project).each do |person|
            %div{ class: 'private_user'}
              %input{ id: "#{f.object.id}_private_#{person.id}", name: "task[comments_attributes][0][private_ids][]", type: 'checkbox', value: person.user_id, checked: parent_form.object.watcher_ids.include?(person.user_id), data: { 'private-box-target' => 'personInput', 'checkbox-select-all-target' => 'checkbox' } }
              %label{ for: "#{f.object.id}_private_#{person.id}"}= person.name

  .actions
    .attach
      %span= t('.attach') + ": "
      = link_to t('uploads.comment_upload_link'), '#uploads', :class => 'attach_icon hoverable', :title => "Attach a file", data: { action: 'click->comment#toggleUpload' }
      - #Rails.configuration.teambox.providers.detect { |p| p.provider == 'google' }
      = render 'google_docs/form', :f => f
      - if task_form
        = link_to t('comments.hours.tooltip'), '#hours', :class => 'add_hours_icon hoverable', :title => "Log hours"
      = link_to "Watchers", '#watchers', :class => 'add_watchers hoverable', :title => "Notify people", data: { action: 'click->comment#toggleWatchers' }
      = link_to "Privacy", '#privacy', :class => 'private_switch hoverable', :title => "Control who can see this element", data: { action: 'click->comment#togglePrivacy' }

    - if task_form
      .task_actions
        = task_form.label :status
        = task_form.select :status, task_statuses_for_select
        = task_form.label :assigned_id, t('comments.new.assigned_to')
        = task_form.select :assigned_id, options_for_projects_people(target.project), { include_blank: true }, :'data-assigned' => task_form.object.assigned_id
        = task_form.label :due_on
        = date_picker(task_form, :due_on)

    - if !local_assigns[:project]
      %span.new{ :style => 'display: none' }
        &larr; &nbsp;&nbsp;
        = t('comments.watchers.popup_note_html')

    - if local_assigns[:conversation_form] && local_assigns[:project]
      - if target && can?(:update, target) && can?(:make_tasks, local_assigns[:project])
        %span.convert_to_task
          = link_to t('comments.conversations.convert_to_task'), '#convert_to_task'
        .convert_to_task{:style => 'display:none;'}
          .conversation_actions
            - if @conversation || local_assigns[:conversation_form]
              %div{id: dom_id(@conversation || local_assigns[:conversation_form].object, :errors)}
            .fields
              = conversation_form.label :name, "#{t('conversations.convert_form.name')}:"
              = conversation_form.text_field :name, :placeholder => t('comments.conversations.task_name'), :error_message => t('tasks.errors.name.cant_be_blank'), :disabled => true, :class => 'required'
            .fields
              = conversation_form.label :task_list_id, "#{t('conversations.convert_form.task_list')}:"
              = conversation_form.select :task_list_id, [[t('comments.comment.loading'),""]], {}, :disabled => true
            .fields
              = conversation_form.label :status, "#{t('conversations.convert_form.status')}:"
              = conversation_form.select :status, task_statuses_for_select, {}, :disabled => true
              = conversation_form.select :assigned_id, [], {}, :'data-assigned' => conversation_form.object.assigned_id, :disabled => true
            .fields.fields-due-on
              = conversation_form.label :due_on, "#{t('conversations.convert_form.due_on')}:"
              = date_picker(conversation_form, :due_on, {}, :disabled => true)
          .submit
            = link_to t('common.cancel'), '#cancel_conversion', :class => 'cancel'
            = f.submit t('comments.convert_form.submit'), :'data-disable-with' => t('comments.new.sending'), :disabled => true

  .submit
    %span.help= formatting_documentation_link
    = f.submit t('comments.new.submit'), :'data-disable-with' => t('comments.new.sending')
