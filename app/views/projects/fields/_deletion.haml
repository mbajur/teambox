- unless project.archived
  = archive_project_link(project)
  = t('common.or')

#delete_project_html{:style => 'display: none'}
  %h2= t('projects.fields.delete_project.title', :project => project.name)
  %p= t('projects.fields.delete_project.body_html')

= f.hidden_field :archived

= button_to t('projects.fields.forever'), project_path(project), :method => :delete, :class => 'button', :data => { :confirm => "#{t('projects.fields.delete_project.title', :project => project.name)} #{t('projects.fields.delete_project.body_html')}" }
