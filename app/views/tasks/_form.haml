- shown = %w[new edit].include?(action_name)
- task_action = task.new_record?? :new : :edit
- i18n_scope = [:tasks, task_action]

= form_for [project, task_list, task], :html => { :class => "app_form #{task_action}_task", :multipart => true, :'data-remote' => false, :'data-project-id' => project.id, :'data-mine' => (task.open? and task.assigned_to?(current_user)), 'data-controller' => 'comment', 'data-comment-users-to-mention-value' => users_to_mention(project).to_json, :id => local_assigns[:form_id] } do |form|
  = form.hidden_field :redirect_mode, value: local_assigns[:redirect_mode] || :show
  = render 'tasks/fields', :f => form, :project => project
  .submit
    - unless shown
      = link_to t('common.cancel'), '#cancel'
    = #preview_button
    = form.submit t(:submit, :scope => i18n_scope), :'data-disable-with' => t(:sending, :scope => i18n_scope)
