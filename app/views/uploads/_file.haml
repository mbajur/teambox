.upload_file{:id => "upload_#{upload.id}"}
  = file_icon_image(upload,'16px')
  %span.filename
    = link_to upload.asset_blob&.filename, upload.asset
  %span.size
    = '(' + number_to_human_size(upload.asset_blob.byte_size).to_s + ')'
  = render :partial => "uploads/more", :locals => {:upload => upload}
