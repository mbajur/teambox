.more{ data: { controller: 'upload-item', upload_id: upload.id } }
  %a.label{ data: { action: 'click->upload-item#toggleReference' } } More...
  .reference{ style: 'display: none;', id: "reference_more_#{upload.id}", data: { upload_item_target: 'reference' } }
    = link_to t('uploads.public_download.link.anchor'), public_download_project_upload_path(upload.project, upload), title: t('uploads.public_download.link.title')
    = link_to t('uploads.upload.download'), upload.asset
