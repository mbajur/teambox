%div[upload]{ :class => ['file_upload', cycle('alternate', '')], data: { controller: 'upload-item' } }
  .header{ data: { action: 'click->upload-item#toggleReference' } }
    .icon
      = image_tag file_icon_path(upload, '16px')
    .file
      = link_to upload.asset_blob.filename, upload.asset
    .size
      = number_to_human_size upload.asset_blob.byte_size
    .author
      = upload.user
    .more
      [+]

  .reference{ :style => 'display: none', data: { upload_item_target: 'reference' } }
    -# = link_to_upload upload, t('.download'), {:rel => nil}
    = link_to t('.download'), upload.asset
    = link_to t('uploads.public_download.link.anchor'), public_download_project_upload_path(upload.project, upload), :title => t('uploads.public_download.link.title')
    - if can?(:update, upload) # and request.format != :m
      = link_to t('common.rename'), [:edit, upload.project, upload], :remote => true, :class => "link_rename"
      = link_to t('uploads.moveable.title'), project_move_resource_path(upload.project, upload, moveable_type: 'upload'), :class => "move_resource" if upload.moveable?
      = link_to t('common.delete'), [upload.project, upload], :remote => true, :method => 'delete', :confirm => t('confirm.delete_upload')

