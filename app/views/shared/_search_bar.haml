- if current_user.can_search?
  .search_bar
    = form_tag search_path, :method => 'get', :class => 'search', :id => 'search', data: { turbo: true, controller: 'auto-submit', turbo_frame: 'content' } do
      = text_field_tag :q, nil, :type => 'search', :id => :searchbox,
                                :placeholder => t('search.placeholder'),
                                value: params[:q],
                                data: { action: 'auto-submit#submit' }
