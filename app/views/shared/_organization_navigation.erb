<div class="user_navigation"><%
render_tabnav :organization do
    add_tab do |t|
      t.named t('.general_settings')
      t.links_to edit_organization_path
      t.highlights_on :controller => 'organizations', :action => 'edit'
    end

    add_tab do |t|
      t.named t('.appearance')
      t.links_to appearance_organization_path
      t.highlights_on :controller => 'organizations', :action => 'appearance'
    end

    add_tab do |t|
      t.named t('.projects')
      t.links_to projects_organization_path
      t.highlights_on :controller => 'organizations', :action => 'projects'
    end

    add_tab do |t|
      t.named t('.users')
      t.links_to organization_memberships_path(@organization)
      t.highlights_on :controller => 'organizations', :action => 'memberships'
    end
end
%><div class="clear"></div></div>

<% if can?(:create_project, current_user) %>
    <%= link_to t('shared.navigation.new_project'), new_project_path %>
<% end %>
